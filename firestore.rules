rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function ownsStudent(sid) {
      return exists(/databases/$(database)/documents/students/$(sid))
        && get(/databases/$(database)/documents/students/$(sid)).data.claimedBy == request.auth.uid;
    }

    match /students/{studentId} {
      allow read: if isAuth();
      allow update: if isAuth()
        && (resource.data.claimedBy == null || resource.data.claimedBy == request.auth.uid)
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.name  == resource.data.name
        && request.resource.data.order == resource.data.order;
      allow create, delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /queueEntries/{entryId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.name       is string
        && request.resource.data.studentId  is string
        && request.resource.data.subjectId  is string
        && request.resource.data.joinedAt   is timestamp
        && request.resource.data.expiresAt  is timestamp
        && request.resource.data.expiresAt.toMillis() > request.resource.data.joinedAt.toMillis()
        && request.resource.data.expiresAt.toMillis() <= request.resource.data.joinedAt.toMillis() + 7200000
        && ownsStudent(request.resource.data.studentId);
      allow update: if false;
      allow delete: if isAuth() && ownsStudent(resource.data.studentId);
    }
  }
}